# Copy to .env and replace every value: cp .env.example .env
# Generate secrets with: openssl rand -base64 32   (JWT: openssl rand -base64 64 | tr -d '\n')

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# OIDC client secrets, imported into the Keycloak realm and used by the services
KEYCLOAK_WEB_APP_CLIENT_SECRET=change-me
KEYCLOAK_INTERNAL_CLIENT_SECRET=change-me

GATEWAY_DB_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me

JHIPSTER_JWT_BASE64_SECRET=change-me

# Observability (observability/compose.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
