# Copy to deploy/.env.prod, fill in, then run deploy/deploy.sh <ssh-host>.
# Generate secrets with: openssl rand -hex 24   (JWT: openssl rand -base64 64 | tr -d '\n')

# Public hostname; point DOMAIN, admin.DOMAIN, auth.DOMAIN and grafana.DOMAIN at the VM (A records) before deploying
DOMAIN=tickets.example.com
# Let's Encrypt registration
ACME_EMAIL=you@example.com

# Password of the realm's "admin" user (organiser role) on the public demo; buyers sign up themselves
DEMO_ADMIN_PASSWORD=change-me

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_WEB_APP_CLIENT_SECRET=change-me
KEYCLOAK_INTERNAL_CLIENT_SECRET=change-me

GATEWAY_DB_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
# HMAC key for the QR codes on e-tickets
TICKET_SIGNING_SECRET=change-me
# HMAC key shared by gateway (signs) and order (verifies) for waiting room passes
QUEUE_PASS_SECRET=change-me
PAYMENT_DB_PASSWORD=change-me

JHIPSTER_JWT_BASE64_SECRET=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# 1.0 traces every request (fine for a demo); lower it during load tests
TRACING_SAMPLING_PROBABILITY=1.0
