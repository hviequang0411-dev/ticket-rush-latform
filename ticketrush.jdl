/*
 * TicketRush - Phase 3: gateway, catalog, inventory, order, payment
 * Target: generator-jhipster 9.4.0 (Spring Boot 4.1.1, Spring Cloud 2025.1.3, Java 21)
 *
 * Notes:
 * - The gateway is reactive (Spring Cloud Gateway WebFlux). JHipster 9.4 rejects a
 *   non-reactive gateway unless --experimental is passed.
 * - Ticket availability is NOT stored in catalog. totalQuantity here is the
 *   configured capacity; live stock and holds belong to the inventory service (phase 2).
 * - Cross-service references (ticketTypeId, eventId, orderId) are plain ids, not
 *   relationships: each service owns its database, so there are no cross-DB foreign keys.
 * - StockHold is internal to inventory and is not exposed in the gateway UI.
 */

application {
  config {
    baseName gateway
    applicationType gateway
    packageName com.ticketrush.gateway
    serverPort 8080
    reactive true
    authenticationType oauth2
    serviceDiscoveryType consul
    databaseType sql
    devDatabaseType postgresql
    prodDatabaseType postgresql
    buildTool maven
    clientFramework react
    nativeLanguage en
    languages [en, vi]
    testFrameworks []
  }
  entities Venue, Event, TicketType, TicketStock, Order, OrderItem, Payment
}

application {
  config {
    baseName catalog
    applicationType microservice
    packageName com.ticketrush.catalog
    serverPort 8081
    reactive false
    authenticationType oauth2
    serviceDiscoveryType consul
    databaseType sql
    devDatabaseType postgresql
    prodDatabaseType postgresql
    cacheProvider redis
    enableHibernateCache true
    messageBroker kafka
    buildTool maven
    nativeLanguage en
    languages [en, vi]
  }
  entities Venue, Event, TicketType
}

application {
  config {
    baseName inventory
    applicationType microservice
    skipClient true
    packageName com.ticketrush.inventory
    serverPort 8082
    reactive false
    authenticationType oauth2
    serviceDiscoveryType consul
    databaseType sql
    devDatabaseType postgresql
    prodDatabaseType postgresql
    cacheProvider no
    enableHibernateCache false
    messageBroker kafka
    buildTool maven
    nativeLanguage en
    languages [en, vi]
  }
  entities TicketStock, StockHold
}

application {
  config {
    baseName order
    applicationType microservice
    skipClient true
    packageName com.ticketrush.order
    serverPort 8083
    reactive false
    authenticationType oauth2
    serviceDiscoveryType consul
    databaseType sql
    devDatabaseType postgresql
    prodDatabaseType postgresql
    cacheProvider no
    enableHibernateCache false
    messageBroker kafka
    buildTool maven
    nativeLanguage en
    languages [en, vi]
  }
  entities Order, OrderItem
}

application {
  config {
    baseName payment
    applicationType microservice
    skipClient true
    packageName com.ticketrush.payment
    serverPort 8084
    reactive false
    authenticationType oauth2
    serviceDiscoveryType consul
    databaseType sql
    devDatabaseType postgresql
    prodDatabaseType postgresql
    cacheProvider no
    enableHibernateCache false
    messageBroker kafka
    buildTool maven
    nativeLanguage en
    languages [en, vi]
  }
  entities Payment, PaymentWebhookEvent
}

enum EventStatus {
  DRAFT,
  PUBLISHED,
  CANCELLED,
  ENDED
}

entity Venue {
  id Long
  name String required maxlength(200)
  address String required maxlength(500)
  city String required maxlength(100)
  capacity Integer required min(1)
}

entity Event {
  id Long
  name String required maxlength(200)
  slug String required unique maxlength(220) pattern(/^[a-z0-9]+(-[a-z0-9]+)*$/)
  description TextBlob
  startTime Instant required
  endTime Instant
  status EventStatus required
  posterUrl String maxlength(1000)
}

entity TicketType {
  id Long
  name String required maxlength(100)
  price BigDecimal required min(0)
  currency String required minlength(3) maxlength(3)
  totalQuantity Integer required min(1)
  saleStart Instant
  saleEnd Instant
}

relationship ManyToOne {
  Event{venue(name) required} to Venue
}

relationship OneToMany {
  Event{ticketTypes} to TicketType{event(name) required}
}

// ---------- inventory ----------

/** Live stock per ticket type. Decremented only by a conditional UPDATE (see ADR 0003). */
entity TicketStock {
  id Long
  ticketTypeId Long required unique
  eventId Long required
  totalQuantity Integer required min(0)
  availableQuantity Integer required min(0)
}

enum HoldStatus {
  HELD,
  CONFIRMED,
  RELEASED,
  EXPIRED
}

/** Seats held for an order for 10 minutes; one row per (order, ticket type). Written only by reservations. */
@readOnly
entity StockHold {
  id Long
  orderId Long required
  quantity Integer required min(1)
  status HoldStatus required
  expiresAt Instant required
  createdAt Instant required
}

relationship ManyToOne {
  StockHold{stock required} to TicketStock
}

// ---------- order ----------

enum OrderStatus {
  PENDING,
  RESERVED,
  AWAITING_PAYMENT,
  CONFIRMED,
  CANCELLED,
  EXPIRED,
  FAILED,
  REFUNDED
}

/** Created only through checkout; the admin API is read-only. */
@readOnly
entity Order(ticket_order) {
  id Long
  code String required unique maxlength(32)
  userLogin String required maxlength(100)
  status OrderStatus required
  totalAmount BigDecimal required min(0)
  currency String required minlength(3) maxlength(3)
  idempotencyKey String required unique maxlength(64)
  failureReason String maxlength(255)
  expiresAt Instant
  createdAt Instant required
  updatedAt Instant
}

@readOnly
entity OrderItem {
  id Long
  eventId Long required
  ticketTypeId Long required
  quantity Integer required min(1) max(10)
  unitPrice BigDecimal required min(0)
}

relationship OneToMany {
  Order{items} to OrderItem{order required}
}

// ---------- payment ----------

enum PaymentProvider {
  MOCK,
  VNPAY,
  MOMO
}

enum PaymentStatus {
  PENDING,
  SUCCEEDED,
  FAILED,
  EXPIRED,
  REFUNDED
}

/** One payment attempt for an order. Created by the order saga; the admin API is read-only. */
@readOnly
entity Payment {
  id Long
  orderId Long required
  orderCode String required maxlength(32)
  amount BigDecimal required min(0)
  currency String required minlength(3) maxlength(3)
  provider PaymentProvider required
  status PaymentStatus required
  providerRef String required unique maxlength(64)
  providerTransactionId String maxlength(64)
  paymentUrl String maxlength(2000)
  failureReason String maxlength(255)
  expiresAt Instant required
  createdAt Instant required
  updatedAt Instant
}

/** Every provider callback as received; (provider, eventKey) is unique, so a redelivered webhook is a no-op. */
@readOnly
entity PaymentWebhookEvent {
  id Long
  provider PaymentProvider required
  eventKey String required maxlength(128)
  payload TextBlob required
  signatureValid Boolean required
  receivedAt Instant required
  processedAt Instant
}

relationship ManyToOne {
  PaymentWebhookEvent{payment} to Payment
}

service * with serviceImpl
dto * with mapstruct
paginate Venue, Event, TicketStock, Order, Payment with pagination
filter Event, Order
microservice Venue, Event, TicketType with catalog
microservice TicketStock, StockHold with inventory
microservice Order, OrderItem with order
microservice Payment, PaymentWebhookEvent with payment

deployment {
  deploymentType docker-compose
  appsFolders [gateway, catalog, inventory, order, payment]
  serviceDiscoveryType consul
  monitoring no
}
