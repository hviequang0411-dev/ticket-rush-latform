<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- How often the provider sent the same callback: retries are stored once but still visible -->
    <changeSet id="20261031100000-1" author="ticketrush">
        <addColumn tableName="payment_webhook_event">
            <column name="deliveries" type="integer" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="last_received_at" type="timestamp with time zone"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
