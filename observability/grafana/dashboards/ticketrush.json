        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"gateway\",status=\"429\"}[1m]))",
          "legendFormat": "429/s",
          "exemplar": true
        }
      ]
    },
    {
